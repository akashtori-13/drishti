{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpectraHunt",
  "version": "1.0.0",
  "identifier": "org.spectrahunt.app",
  "build": {
    "frontendDist": "../../spectrahunt-web/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --prefix ../spectrahunt-web",
    "beforeDevCommand": "npm run dev --prefix ../spectrahunt-web"
  },
  "app": {
    "windows": [{ "title": "SpectraHunt", "width": 1280, "height": 860 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
